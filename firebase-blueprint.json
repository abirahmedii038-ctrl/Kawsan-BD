{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fashion clothing product item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "descriptionBn": { "type": "string", "maxLength": 2000 },
        "stock": { "type": "number" },
        "fabric": { "type": "string", "maxLength": 100 },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "district": { "type": "string", "maxLength": 50 },
        "upazila": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "district", "address", "items", "total", "status"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration and customization options",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 300 },
        "heroBannerUrl": { "type": "string", "maxLength": 1000 },
        "insideDhakaDeliveryFee": { "type": "number" },
        "outsideDhakaDeliveryFee": { "type": "number" },
        "announcementText": { "type": "string", "maxLength": 300 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "instagramUrl": { "type": "string", "maxLength": 500 },
        "codEnabled": { "type": "boolean" },
        "bkashNumber": { "type": "string", "maxLength": 30 },
        "nagadNumber": { "type": "string", "maxLength": 30 }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized store administrator record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 20 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Clothing inventory and catalog entries"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with fulfillment status"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store branding and regional settings"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "System administrator accounts"
    }
  }
}
